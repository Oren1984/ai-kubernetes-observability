    {
      "id": 14,
      "type": "timeseries",
      "title": "CPU: usage vs request",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
