      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "The Collector's own exporter counters: what actually left each pipeline."
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Failed calls seen by traffic-generator",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
