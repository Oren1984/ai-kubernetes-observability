    {
      "id": 15,
      "type": "timeseries",
      "title": "OpenTelemetry Collector throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_exporter_sent_spans_total[1m]))",
          "legendFormat": "spans/s to Tempo",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(otelcol_exporter_sent_log_records_total[1m]))",
          "legendFormat": "log records/s to Loki",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(otelcol_exporter_sent_metric_points_total[1m]))",
          "legendFormat": "metric points/s to Prometheus",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
