{
  "uid": "aiobs-incident",
  "title": "Incident Investigation",
  "description": "Metrics, logs and traces for one incident window, side by side.",
  "tags": [
    "aiobs",
    "opentelemetry"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Fault injected (test harness)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "demo_fault_injection_active{service_name=\"demo-api\"} == 1",
        "step": "15s",
        "titleFormat": "Fault injected: {{scenario}}",
        "textFormat": "Marker from the test harness. The analysis engine does not read this metric."
      },
      {
        "name": "Container restarted",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "max(k8s_container_restarts{k8s_namespace_name=\"aiobs-demo\",k8s_container_name=\"demo-api\"}) - max(k8s_container_restarts{k8s_namespace_name=\"aiobs-demo\",k8s_container_name=\"demo-api\"} offset 30s) > 0",
        "step": "15s",
        "titleFormat": "demo-api container restarted"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to use",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "targets": [],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Set the time range to the incident window (the Streamlit dashboard links here with the window pre-filled). Read left to right: **what changed** in the metrics, **what the service said** in its logs, and **where the time or the failure is** in the traces. Click a log line's `trace_id` to open its trace; from a trace you can jump back to its logs. Orange markers = fault injected by the test harness. Red markers = container restart."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error ratio (5xx / all)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "(sum(rate(http_server_request_duration_seconds_count{service_name=\"demo-api\",http_route=\"/api/work\",http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{service_name=\"demo-api\",http_route=\"/api/work\"}[$__rate_interval]))",
          "legendFormat": "5xx ratio",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"demo-api\",http_route=\"/api/work\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"demo-api\",http_route=\"/api/work\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"demo-api\",http_route=\"/api/work\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory vs limit, and restarts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(k8s_container_memory_limit_utilization_ratio{k8s_namespace_name=\"aiobs-demo\",k8s_container_name=\"demo-api\"})",
          "legendFormat": "memory / limit",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max(k8s_container_restarts{k8s_namespace_name=\"aiobs-demo\",k8s_container_name=\"demo-api\"})",
          "legendFormat": "restart count",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "memory / limit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "restart count"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Application logs: WARN and above (click trace_id to open the trace)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{service_name=\"demo-api\"} | severity_text=~\"WARN|WARNING|ERROR|CRITICAL\"",
          "queryType": "range",
          "maxLines": 200,
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Kubernetes events: demo namespace",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{service_name=\"kubernetes-events\"} | json | line_format \"{{.object_type}} {{.object_reason}} - {{.object_involvedObject_name}} - {{.object_message}}\"",
          "queryType": "range",
          "maxLines": 100,
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "description": "Collected by the Collector's k8s_objects receiver and stored in Loki."
    },
    {
      "id": 7,
      "type": "table",
      "title": "Failed or slow traces: demo-api span with error status, or server span over 300 ms (duration shown is the whole trace)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "queryType": "traceql",
          "limit": 60,
          "tableType": "traces",
          "query": "{resource.service.name=\"demo-api\" && (status=error || (kind=server && duration>300ms))}",
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Log volume by severity",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (severity_text) (count_over_time({service_name=\"demo-api\"} [$__interval]))",
          "legendFormat": "{{severity_text}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Request rate by status code",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"demo-api\",http_route=\"/api/work\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{http_response_status_code}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "links": [
    {
      "title": "Incident Intelligence (Streamlit)",
      "url": "http://localhost:18501",
      "type": "link",
      "targetBlank": true,
      "icon": "external link"
    }
  ]
}