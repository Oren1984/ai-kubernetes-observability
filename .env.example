# Copy to .env (scripts/start.ps1 does this on first run). Never commit .env.

# Grafana admin login. Anonymous visitors get read-only access regardless.
GRAFANA_ADMIN_PASSWORD=change-me-locally

# Incident analysis narrative. The deterministic rule engine always runs;
# this only selects who writes the explanation on top of it.
#   mock   - built-in offline explainer, no network, no key (default)
#   openai - any OpenAI-compatible /chat/completions endpoint (incl. local models)
#   none   - deterministic output only
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
